{
  "name": "gyomen-biyori",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:compile && npm run test:unit && npm run test:schema",
    "test:compile": "rm -rf .test-dist && tsc -p tests/tsconfig.json",
    "test:unit": "node .test-dist/tests/recommendation.test.js",
    "test:schema": "node .test-dist/tests/schema.test.js",
    "test:integration": "npm run test:compile && node .test-dist/tests/integration.test.js",
    "seed:draft-v2": "node --experimental-strip-types scripts/seed-draft-v2.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "leaflet": "1.9.4",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/node": "24.0.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3"
  }
}
