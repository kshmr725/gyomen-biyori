# Supabase — optional for public browsing/recommendation, required for Google sign-in,
# favorites, visit history, ratings, admin writes, and persistent route cache.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Routing provider. Default is the public Valhalla demo endpoint and requires no key.
# Fair-use only; set a stable identifier for the X-Client-Id header.
ROUTING_PROVIDER=valhalla
ROUTING_CLIENT_ID=gyomen-biyori
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de

# Optional upgrade path. When ROUTING_PROVIDER=ors, provide this key.
ORS_API_KEY=

# Local-only fallback. Never enable in production because it estimates rather than routes.
NEXT_PUBLIC_DEMO_MODE=false

# OAuth callback / canonical site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
