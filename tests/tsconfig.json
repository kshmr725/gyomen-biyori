{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "..",
    "outDir": "../.test-dist"
  },
  "include": [
    "recommendation.test.ts",
    "schema.test.ts",
    "integration.test.ts",
    "../src/lib/types.ts",
    "../src/lib/hours.ts",
    "../src/lib/recommendation.ts",
    "../src/lib/seed.ts",
    "../src/lib/seed-v2.ts",
    "../src/lib/importer/seed-importer.ts",
    "../src/lib/types/database.ts"
  ]
}
